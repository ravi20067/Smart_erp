# Smart ERP Face AI Service Configuration
APP_NAME=Smart ERP Face AI
APP_ENV=development
HOST=127.0.0.1
PORT=8001
WORKERS=1
API_V1_PREFIX=/internal/v1/face

# Internal Service Authentication (Spring Boot to Python)
# Set to true in production and provide a secure random key
REQUIRE_INTERNAL_AUTH=false
INTERNAL_API_KEY=

# Biometric Verification Threshold
# Calibrated cosine similarity threshold (e.g., 0.60 to 0.70)
# Leave blank to require calibration before automatic matching decisions
FACE_MATCH_THRESHOLD=

# File and Batch Constraints
MAX_IMAGE_SIZE_MB=5
MAX_FRAMES_PER_BATCH=15

# Verification Session Settings
SESSION_TTL_SECONDS=120
MAX_CONCURRENT_SESSIONS=100
SESSION_CLEANUP_INTERVAL_SECONDS=30

# Model Asset Paths (Relative to repository root)
MODEL_YUNET=models/yunet/face_detection_yunet_2023mar.onnx
MODEL_SFACE=models/sface/face_recognition_sface_2021dec.onnx
MODEL_ANTISPOOF=models/antispoof/2.7_80x80_MiniFASNetV2.onnx
MODEL_LANDMARKS=models/landmarks/face_landmarker.task

# Quality & Detection Thresholds
YUNET_CONFIDENCE_THRESHOLD=0.85
YUNET_NMS_THRESHOLD=0.3
MIN_FACE_WIDTH=80
MIN_FACE_HEIGHT=80
MIN_BLUR_LAPLACIAN_VAR=40.0
MIN_BRIGHTNESS=40.0
MAX_BRIGHTNESS=230.0

# Active Liveness & Blink Thresholds
BLINK_EAR_THRESHOLD=0.30
BLINK_BLENDSHAPE_THRESHOLD=0.45
BLINK_MIN_FRAMES=1
BLINK_MAX_FRAMES=10
MAX_PROLONGED_CLOSURE_FRAMES=25

# Head Pose Thresholds (Degrees)
POSE_YAW_THRESHOLD=16.0
POSE_PITCH_THRESHOLD=14.0
POSE_STRAIGHT_THRESHOLD=12.0
POSE_HYSTERESIS=4.0
POSE_MIN_CONSECUTIVE_FRAMES=2
